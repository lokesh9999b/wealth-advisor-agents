# Copy this file to `.env` and fill in values to enable optional features.
# Everything here is OPTIONAL — the system runs fully without any of it.

# Enables the LLM-generated advisory narrative (Claude). If unset, the system
# produces a deterministic templated narrative instead.
ANTHROPIC_API_KEY=

# Which Claude model to use for the narrative (default: claude-opus-5).
WA_MODEL=claude-opus-5

# Set to 1 to force the mock CRM "API" to fail, to demonstrate retry +
# graceful degradation. Default: 0 (disabled).
WA_SIMULATE_CRM_FAILURE=0

# Default log level for console output (DEBUG, INFO, WARNING, ERROR).
WA_LOG_LEVEL=INFO
